{
  "name": "dsh-openclaw-enterprise-team",
  "version": "0.1.0-alpha.1",
  "description": "OpenClaw Enterprise AI Team bridge for DeepSeek Harness",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check lib/openclaw.js",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "openclaw",
    "enterprise-ai",
    "multi-agent",
    "agent-team"
  ],
  "author": "Ulysses",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youwenkui/dsh-openclaw-enterprise-team.git"
  },
  "bugs": {
    "url": "https://github.com/youwenkui/dsh-openclaw-enterprise-team/issues"
  },
  "homepage": "https://github.com/youwenkui/dsh-openclaw-enterprise-team#readme",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
